# ===================================================================
# Archivo de ejemplo de variables de entorno (.env.example)
# Copia este archivo como .env y ajusta los valores para tu entorno:
# cp .env.example .env (Linux/macOS) o copy .env.example .env (Windows)
# ===================================================================

# Configuración de MySQL para Docker Compose y entornos locales
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=ecommerce_secret_password
MYSQL_ROOT_PASSWORD=root_secret_password
MYSQL_PORT=3306
API_PORT=8000

# Cadena de conexión para la aplicación
# 1. Para ejecución local fuera de Docker (conectando a MySQL en localhost):
DATABASE_URL=mysql+pymysql://ecommerce_user:ecommerce_secret_password@localhost:3306/ecommerce_db

# 2. Para ejecución en Docker Compose (la API utiliza automáticamente el host 'db'):
# DATABASE_URL=mysql+pymysql://ecommerce_user:ecommerce_secret_password@db:3306/ecommerce_db
